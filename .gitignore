# 操作系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# 运行产物与日志
runs/
*.log

# 隐私候选预览图，源自原始样本，不得提交
reports/privacy/

# 模型权重与本地缓存目录
models/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# 原始样本图像。保留目录结构、说明文件与占位文件。
data/raw_samples/**/*.jpg
data/raw_samples/**/*.jpeg
data/raw_samples/**/*.JPG
data/raw_samples/**/*.JPEG
data/raw_samples/**/*.png
data/raw_samples/**/*.PNG
data/raw_samples/**/*.heic
data/raw_samples/**/*.HEIC
data/raw_samples/**/*.webp
data/raw_samples/**/*.bmp

# 公开数据集（仅供管线调试与合成增广，不得进入自采样本与评估集）
data/raw_samples/external-assets/

# 标注图像
data/annotations/**/*.jpg
data/annotations/**/*.png

# 打码后的发布副本，仅保留目录说明
data/release/**/*.jpg
data/release/**/*.jpeg
data/release/**/*.png

# 合成试点图像（可复现，不入库；保留清单与说明）
data/synthetic/**/*.jpg
data/synthetic/**/*.jpeg
data/synthetic/**/*.png
data/synthetic/**/gallery.html

# 临时文件
*.tmp
*.bak

# 网页临时结果
web/results/
web/tmp/
